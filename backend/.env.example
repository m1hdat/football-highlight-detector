# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Event detection model
INFERENCE_DEVICE=cpu
TOP_K_HIGHLIGHTS=10
SPOTTER_V2_WINDOW=1024
SPOTTER_V2_OVERLAP=256
SPOTTER_V2_MERGE_DISTANCE_SEC=5

# Official SoccerNet extractor
# Recommended: let the backend launch the dedicated environment with Conda.
SOCCERNET_EXECUTION_MODE=conda
SOCCERNET_CONDA_ENV=SoccerNet-FeatureExtraction
SOCCERNET_CONDA_EXE=conda

# Optional advanced override. Set SOCCERNET_EXECUTION_MODE=python first.
# SOCCERNET_EXTRACTOR_PYTHON=C:\Users\you\miniconda3\envs\SoccerNet-FeatureExtraction\python.exe

SOCCERNET_GPU=-1
SOCCERNET_TRANSFORM=crop
SOCCERNET_GRABBER=opencv
SOCCERNET_EXTRACT_TIMEOUT_SEC=21600
SOCCERNET_PREFLIGHT_TIMEOUT_SEC=120
SOCCERNET_CHUNK_DURATION_SEC=300

# Upload
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_MB=8
MIN_VIDEO_DURATION_SEC=2
MAX_VIDEO_DURATION_SEC=10800

# Cleanup
CLEANUP_INPUTS_AFTER_SUCCESS=true
KEEP_FAILED_INPUTS=true
STALE_INPUT_TTL_HOURS=24
OUTPUT_TTL_HOURS=24
CLEANUP_ON_STARTUP=true

# External tools
FFMPEG_TIMEOUT_SEC=1800
FFPROBE_TIMEOUT_SEC=30
